# Copy to apps/web/.env.local; never commit credentials.
# Never copy provider secrets into NEXT_PUBLIC_* variables.

# F02 — MongoDB (server-only). Use an isolated development database on a transaction-capable deployment (Atlas or replica set).
MONGODB_URI=
MONGODB_DB_NAME=namastevideo_dev
# Optional: separate operator credential for `npm run db:migrate`; falls back to MONGODB_URI for local development.
MONGODB_MIGRATION_URI=
# Optional: connection pool size per server instance (1-100, default 10).
MONGODB_MAX_POOL_SIZE=

# F03 — Better Auth (server-only). Generate the secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Exact app origin; used for cookies and the Origin check on sign-in/sign-out.
# `npm run dev` serves https://localhost:3000 (HTTPS front door, needed for Instagram); use http://127.0.0.1:3000 with `npm run dev:http`.
BETTER_AUTH_URL=https://localhost:3000

# F08/F13 — AI providers (server-only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# F12 — Private Cloudflare R2 bucket (server-only). Token scoped to Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=namastevideo-dev

# F13 — Inngest. Local development: INNGEST_DEV=1 with `npm run dev:inngest` (no account).
# Production: INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY from an Inngest account instead.
INNGEST_DEV=1

# Instagram API with Instagram Login (F18). App ID/secret from Meta dashboard → Instagram → API setup with Instagram
# login. The redirect URI must exactly match the one saved there (HTTPS required). INSTAGRAM_TOKEN_KEY: 64 hex chars
# (32 random bytes) used for AES-256-GCM token encryption; generate with `openssl rand -hex 32`. Never commit values.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:3000/api/instagram/callback
INSTAGRAM_TOKEN_KEY=

# Publishing (F19): public HTTPS origin Instagram fetches approved MP4s from (media gateway only). Normally left empty:
# `npm run media-tunnel` creates a temporary Cloudflare link and writes it to apps/web/.runtime/media-origin.
MEDIA_PUBLIC_ORIGIN=
