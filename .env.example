# Copy to .env.local; never commit credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_INDIAN_MALE=
ELEVENLABS_VOICE_ID_INDIAN_FEMALE=
# Optional installed Chromium/Chrome binary; otherwise Remotion downloads its browser.
BROWSER_EXECUTABLE=
